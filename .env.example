# Run uvicorn with --env-file .env to load these backend settings.
MODEL_PROVIDER=mock
MODEL_NAME=gemini-2.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
ALLOW_EXTERNAL_UPLOADS=false

# The API keeps completed run results and events for 24 hours.
RUN_DB_PATH=runs.sqlite3
RUN_RETENTION_HOURS=24
RAGATHON_PUBLIC=false
RAGATHON_API_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to http://localhost:8000 to connect the Vite dashboard.
VITE_API_URL=http://localhost:8000

# Supabase browser configuration (publishable/anon key only; never expose service_role)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this name instead:
# VITE_SUPABASE_ANON_KEY=
