# Optional model generation and second review (mock, gemini, or groq).
MODEL_PROVIDER=mock
MODEL_NAME=gemini-2.5-flash
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional RAG provider configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=openai/text-embedding-3-small
VECTOR_STORE=local
CHECKPOINT_DB_PATH=agentverse.sqlite3
MAX_REVISION_COUNT=2
QUALITY_PASS_SCORE=88

# Optional external search configuration
SEARCH_API_KEY=
SERPAPI_API_KEY=
TAVILY_API_KEY=
ALLOW_EXTERNAL_UPLOADS=false

# The API keeps completed run results and events for 24 hours.
RUN_DB_PATH=runs.sqlite3
RUN_RETENTION_HOURS=24
RAGATHON_PUBLIC=false
RAGATHON_API_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Set to http://localhost:8000 to connect the Vite dashboard.
VITE_API_URL=http://localhost:8000

# Supabase browser configuration (publishable/anon key only; never expose service_role)
VITE_SUPABASE_URL=https://qnoaezyqryizzblqxjmz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AUTH_REDIRECT_URL=http://localhost:5173
# Legacy projects may use this name instead:
# VITE_SUPABASE_ANON_KEY=
# Backend-only JWT secret from Supabase Project Settings > API
SUPABASE_JWT_SECRET=

# Optional inbox for the Settings Contact us link.
VITE_SUPPORT_EMAIL=
